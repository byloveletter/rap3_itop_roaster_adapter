#!/bin/bash
# Calibrate the Waveshare 3.5" XPT2046 touch with tslib and apply the result as a
# libinput calibration matrix. Runs as root from touch-calibrate.service because the
# desktop (lightdm) must be stopped while ts_calibrate draws on the LCD framebuffer.
# Installed as /usr/local/sbin/touch-calibrate by deploy/install-system.sh.
set -u

TOUCH_NAME="ADS7846 Touchscreen"
FB_NAME="ili9486drmfb"
RULE=/etc/udev/rules.d/99-ads7846-calibration.rules
NEW=/run/pointercal.new

find_node() { # $1=sysfs class dir glob, $2=name file, $3=expected name, $4=/dev prefix
    for d in $1; do
        if [ "$(cat "$d/$2" 2>/dev/null)" = "$3" ]; then echo "$4/${d##*/}"; return; fi
    done
}

TS_DEV=$(find_node "/sys/class/input/event*" device/name "$TOUCH_NAME" /dev/input)
FB_DEV=$(find_node "/sys/class/graphics/fb*" name "$FB_NAME" /dev)
if [ -z "$TS_DEV" ] || [ -z "$FB_DEV" ]; then
    echo "touch ($TS_DEV) or LCD framebuffer ($FB_DEV) not found" >&2
    exit 1
fi

systemctl stop lightdm
sleep 2

rm -f "$NEW"
TSLIB_FBDEVICE="$FB_DEV" TSLIB_TSDEVICE="$TS_DEV" TSLIB_CONSOLEDEVICE=none \
    TSLIB_CALIBFILE="$NEW" timeout 120 ts_calibrate

if [ -s "$NEW" ]; then
    install -m 644 "$NEW" /etc/pointercal
    # tslib maps raw -> pixels: x = (a0*X + a1*Y + a2) / a6, y = (a3*X + a4*Y + a5) / a6.
    # libinput wants the same affine map in normalized (0..1) device and screen coordinates.
    MATRIX=$(python3 - "$TS_DEV" <<'PY'
import array, fcntl, sys
EVIOCGABS = lambda code: 0x80184540 + code
def absmax(f, code):
    buf = array.array('i', [0] * 6)
    fcntl.ioctl(f, EVIOCGABS(code), buf)
    return buf[2] - buf[1]
with open(sys.argv[1], 'rb') as f:
    rx, ry = absmax(f, 0), absmax(f, 1)
a = [int(v) for v in open('/etc/pointercal').read().split()]
a0, a1, a2, a3, a4, a5, a6, w, h = a[:9]
m = [a0 * rx / (a6 * w), a1 * ry / (a6 * w), a2 / (a6 * w),
     a3 * rx / (a6 * h), a4 * ry / (a6 * h), a5 / (a6 * h)]
print(' '.join(f'{v:.6f}' for v in m))
PY
)
    cat > "$RULE" <<RULE_EOF
# Waveshare 3.5" XPT2046 touch on the LCD. Generated by /usr/local/sbin/touch-calibrate
# from the tslib ts_calibrate result in /etc/pointercal.
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="$TOUCH_NAME", ENV{LIBINPUT_CALIBRATION_MATRIX}="$MATRIX"
RULE_EOF
    udevadm control --reload
    udevadm trigger --action=change --settle "$TS_DEV"
    echo "calibration applied: $MATRIX"
else
    echo "calibration not completed; previous calibration kept"
fi

systemctl start lightdm
